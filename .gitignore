# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Python build artifacts
*.egg-info/
build/
dist/

# --- Runtime data stores (regenerated by the server) ---
data/
*.sqlite
*.sqlite-journal
saved_agents/
presets/

# --- Model checkpoints ---
*.pt

# --- Node / frontend ---
node_modules/
dashboard/dist/

# --- Local environment config ---
.env
.env.*
!.env.example

# Vast.ai UI-driven deployment: secrets/state live outside the repo
# (~/.decadic/vast.json), but never commit an in-repo copy or generated
# remote launch script either.
*.vast.json
.decadic/
deploy/vast/_run_server.sh

# --- Local working backups (house-rule safety copies; kept local) ---
backups/

# --- Runtime logs (keep the human-readable change log + dir placeholder) ---
logs/*
!logs/.gitkeep
!logs/_change.log

# --- Runtime trace / probe-capture output ---
*.jsonl

# --- MuJoCo auto-generated log ---
MUJOCO_LOG.TXT
